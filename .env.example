# LLM provider — 'gemini' (default, cheap for testing) or 'anthropic'.
LLM_PROVIDER=gemini

# Gemini API key (used when LLM_PROVIDER=gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API key (used when LLM_PROVIDER=anthropic). https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Override the default model for the active provider (optional).
# Defaults: gemini -> gemini-2.5-flash, anthropic -> claude-opus-4-7
# COACH_MODEL=

# Supabase Postgres connection string (TRANSACTION pooler, port 6543).
# Supabase → Project Settings → Database → Connection string → Transaction.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Clerk Auth (lifter AND coach sessions). Create an application at
# https://dashboard.clerk.com, then API Keys -> copy both. Postgres above stays
# on Supabase; only authentication is Clerk's.
#
# In the Clerk dashboard, to match what the app expects:
#   - User & Authentication > Email, Phone, Username: enable Email + Password
#   - SSO Connections: enable Google (the sign-in page renders it automatically)
#   - Email verification must stay ON. lib/auth only claims an existing athlete
#     row on a VERIFIED email, so unverified users cannot reach the app.
# Leave both unset — or leave a placeholder in — and the site still builds and
# renders; the sign-in pages say so and everything else works. lib/clerk-config
# validates the key SHAPE, not just presence, because Clerk's components throw
# on an unparseable key and that fails the build for every prerendered page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk's components send users. These paths are the app's own branded
# pages (app/login, app/coach/login), not Clerk's hosted account portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# Bar-path CV sidecar (Python/FastAPI). See cv-service/README.md.
CV_SERVICE_URL=http://127.0.0.1:8000

# --- Stripe billing (Pro / Coach plans + usage metering) --------------------
# Secret key: https://dashboard.stripe.com/apikeys (use the TEST key in dev).
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Prod: Dashboard → Developers → Webhooks → add endpoint /api/stripe/webhook, copy the secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price IDs. Create three Prices in the Stripe dashboard (Products):
#   Pro   — $12 / month         -> STRIPE_PRICE_PRO_MONTHLY
#   Pro   — $99 / year          -> STRIPE_PRICE_PRO_ANNUAL
#   Coach — $20 / month, per seat (quantity = active clients) -> STRIPE_PRICE_COACH
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_COACH=price_...
# Public base URL used for Stripe redirect (success/cancel/return) URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin allowlist for /admin, /admin/reviews and /admin/reports. An admin is a
# coach who signs in normally and whose Clerk-VERIFIED email is listed here
# (comma-separated).
# Leave unset and NO ONE is an admin — the console is then unreachable, so set
# this in your deployment env or credential/report moderation cannot be done.
ADMIN_EMAILS=
