# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are readable in the app
# bundle (they are NOT secret). Never put the Supabase SECRET key, DB URLs,
# Stripe secret keys, or AI provider keys here — those live only on the backend.

# --- Supabase (Project Settings → API Keys) ------------------------------------
# Supabase now issues two keys: "publishable" (client-safe) and "secret" (server-only).
#
#   Publishable  →  sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx   ← use this one here
#   Secret       →  sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx        ← NEVER put in the app; backend only
#
# The PUBLISHABLE key is safe to ship in the bundle — Row Level Security protects
# your data. The env var is still named ..._ANON_KEY (that's what the app code reads),
# but paste your publishable key into it.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend -------------------------------------------------------------------
# Deployed Next.js backend that serves /api/v1/* (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://liftly.tech

# --- RevenueCat (Dashboard → API keys → Public app-specific keys) ---------------
# Public SDK keys only. Android keys start with "goog_", iOS keys with "appl_".
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
